import gleam/list
import gleam/string
import mochi_studio/schema_node.{
  Enum, FieldDef, InputObject, Object, SchemaNode, Union,
}

fn node(kind, name, fields) {
  SchemaNode(id: name, kind:, name:, fields:, x: 0, y: 0)
}

fn user() {
  node(Object, "User", [
    FieldDef(name: "id", field_type: "ID", non_null: True),
    FieldDef(name: "nickname", field_type: "String", non_null: False),
  ])
}

fn blog_post() {
  node(Object, "BlogPost", [
    FieldDef(name: "title", field_type: "String", non_null: True),
    FieldDef(name: "author", field_type: "User", non_null: True),
    FieldDef(name: "rating", field_type: "Float", non_null: False),
  ])
}

pub fn new_uses_kind_default_name_and_unique_ids_test() {
  let a = schema_node.new(Enum)
  let b = schema_node.new(Enum)
  assert a.name == "MyEnum"
  assert a.fields == []
  assert a.id != b.id
}

pub fn add_field_appends_nullable_string_test() {
  let n = schema_node.add_field(user())
  let assert [_, _, added] = n.fields
  assert added == FieldDef(name: "field", field_type: "String", non_null: False)
}

pub fn nodes_to_gleam_wraps_nullable_fields_in_option_test() {
  assert schema_node.nodes_to_gleam([user()])
    == "pub type User {\n  User(\n  id: String,\n  nickname: option.Option(String)\n  )\n}"
}

pub fn nodes_to_sdl_marks_non_null_and_uses_input_keyword_test() {
  let input =
    node(InputObject, "NewUser", [
      FieldDef(name: "nickname", field_type: "String", non_null: True),
    ])
  assert schema_node.nodes_to_sdl([user(), input])
    == "type User {\n  id: ID!\n  nickname: String\n}\n\ninput NewUser {\n  nickname: String!\n}"
}

pub fn nodes_to_sdl_joins_union_members_test() {
  let search =
    node(Union, "SearchResult", [
      FieldDef(name: "UserResult", field_type: "User", non_null: False),
      FieldDef(name: "PostResult", field_type: "BlogPost", non_null: False),
    ])
  assert schema_node.nodes_to_sdl([search])
    == "union SearchResult = User | BlogPost"
}

pub fn nodes_to_sql_links_object_fields_with_foreign_keys_test() {
  let sql = schema_node.nodes_to_sql([user(), blog_post()])
  assert string.contains(sql, "CREATE TABLE IF NOT EXISTS blog_posts (")
  assert string.contains(sql, "  author UUID REFERENCES users(id) NOT NULL")
  assert string.contains(sql, "  rating DOUBLE PRECISION,")
  assert string.starts_with(sql, "-- Generated by mochi studio\n\nBEGIN;")
  assert string.ends_with(sql, "COMMIT;")
}

pub fn nodes_to_sql_generates_primary_key_when_none_declared_test() {
  let sql = schema_node.nodes_to_sql([blog_post()])
  assert string.split(sql, "id UUID PRIMARY KEY DEFAULT gen_random_uuid()")
    |> list.length
    == 2
}

pub fn nodes_to_sql_skips_non_object_nodes_test() {
  let status =
    node(Enum, "Status", [
      FieldDef(name: "Draft", field_type: "", non_null: False),
    ])
  assert !string.contains(schema_node.nodes_to_sql([status]), "CREATE TABLE")
}

pub fn nodes_to_mochi_schema_builds_type_fns_for_objects_only_test() {
  let status =
    node(Enum, "Status", [
      FieldDef(name: "Draft", field_type: "", non_null: False),
    ])
  let out = schema_node.nodes_to_mochi_schema([user(), status])
  assert string.contains(out, "pub fn user_type() {\n  types.object(\"User\")")
  assert string.contains(out, "  |> types.id(\"id\", fn(u: User) { u.id })")
  assert !string.contains(out, "status_type")
  assert string.contains(out, "pub type Status {\n  Draft\n}")
}
